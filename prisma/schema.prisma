generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String                  @id @default(cuid())
  name            String
  email           String                  @unique
  avatarUrl       String?
  defaultCurrency String                  @default("USD")
  createdAt       DateTime                @default(now())
  memberships     GroupMember[]
  expensesPaid    Expense[]               @relation("ExpensesPaid")
  splits          ExpenseSplit[]
  itemAssignments ExpenseItemAssignment[]
  settlementsSent Settlement[]            @relation("SettlementFrom")
  settlementsRcvd Settlement[]            @relation("SettlementTo")
  comments        Comment[]
  notifications   Notification[]
}

model Group {
  id          String        @id @default(cuid())
  name        String
  type        String        @default("trip") // trip, home, couple, other
  currency    String        @default("USD")
  budgetLimit Float?
  createdBy   String
  createdAt   DateTime      @default(now())
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member") // admin, member
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Expense {
  id              String         @id @default(cuid())
  groupId         String
  description     String
  amount          Float
  currency        String         @default("USD")
  category        String         @default("general") // food, travel, lodging, entertainment, utilities, groceries, shopping
  paidBy          String
  date            DateTime       @default(now())
  receiptImageUrl String?
  splitType       String         @default("equal") // equal, exact, percentage, shares, itemized
  isRecurring     Boolean        @default(false)
  recurringPeriod String?        // weekly, monthly
  createdAt       DateTime       @default(now())
  group           Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer           User           @relation("ExpensesPaid", fields: [paidBy], references: [id])
  splits          ExpenseSplit[]
  items           ExpenseItem[]
  comments        Comment[]
}

model ExpenseSplit {
  id          String   @id @default(cuid())
  expenseId   String
  userId      String
  shareAmount Float
  settled     Boolean  @default(false)
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExpenseItem {
  id          String                  @id @default(cuid())
  expenseId   String
  name        String
  price       Float
  expense     Expense                 @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  assignments ExpenseItemAssignment[]
}

model ExpenseItemAssignment {
  id            String      @id @default(cuid())
  expenseItemId String
  userId        String
  item          ExpenseItem @relation(fields: [expenseItemId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settlement {
  id        String   @id @default(cuid())
  groupId   String
  fromUser  String
  toUser    String
  amount    Float
  status    String   @default("completed") // pending, completed
  method    String?  // UPI, PayPal, Venmo, Cash
  settledAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User     @relation("SettlementFrom", fields: [fromUser], references: [id])
  receiver  User     @relation("SettlementTo", fields: [toUser], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  expenseId String
  userId    String
  text      String
  createdAt DateTime @default(now())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // expense_added, payment_received, reminder
  payload   String   // JSON formatted metadata
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
