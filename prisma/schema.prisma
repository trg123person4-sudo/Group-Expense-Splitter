generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String                  @id @default(cuid())
  name            String?
  email           String                  @unique
  emailVerified   DateTime?
  password        String?
  avatarUrl       String?
  image           String?
  defaultCurrency String                  @default("USD")
  defaultCountry  String?                 @default("US")
  createdAt       DateTime                @default(now())

  accounts        Account[]
  sessions        Session[]
  memberships     GroupMember[]
  expensesPaid    Expense[]               @relation("ExpensesPaid")
  splits          ExpenseSplit[]
  itemAssignments ExpenseItemAssignment[]
  settlementsSent Settlement[]            @relation("SettlementFrom")
  settlementsRcvd Settlement[]            @relation("SettlementTo")
  comments        Comment[]
  notifications   Notification[]
  invitationsSent Invitation[]            @relation("InvitedByUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id          String        @id @default(cuid())
  name        String
  type        String        @default("trip") // trip, home, couple, other
  currency    String        @default("USD")
  country     String?       @default("US") // ISO 3166-1 alpha-2 code e.g. "US", "IN", "DE"
  budgetLimit Float?
  createdBy   String
  createdAt   DateTime      @default(now())
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  invitations Invitation[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member") // admin, member
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Invitation {
  id        String   @id @default(cuid())
  groupId   String
  email     String
  token     String   @unique
  invitedBy String?
  status    String   @default("pending") // pending, accepted, expired, cancelled
  expiresAt DateTime
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter   User?    @relation("InvitedByUser", fields: [invitedBy], references: [id])

  @@unique([groupId, email])
}

model Expense {
  id              String         @id @default(cuid())
  groupId         String
  description     String
  amount          Float
  currency        String         @default("USD")
  category        String         @default("general") // food, travel, lodging, entertainment, utilities, groceries, shopping
  paidBy          String
  date            DateTime       @default(now())
  receiptImageUrl String?
  splitType       String         @default("equal") // equal, exact, percentage, shares, itemized
  isRecurring     Boolean        @default(false)
  recurringPeriod String?        // weekly, monthly
  createdAt       DateTime       @default(now())
  group           Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer           User           @relation("ExpensesPaid", fields: [paidBy], references: [id])
  splits          ExpenseSplit[]
  items           ExpenseItem[]
  comments        Comment[]
}

model ExpenseSplit {
  id          String   @id @default(cuid())
  expenseId   String
  userId      String
  shareAmount Float
  settled     Boolean  @default(false)
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExpenseItem {
  id          String                  @id @default(cuid())
  expenseId   String
  name        String
  price       Float
  expense     Expense                 @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  assignments ExpenseItemAssignment[]
}

model ExpenseItemAssignment {
  id            String      @id @default(cuid())
  expenseItemId String
  userId        String
  item          ExpenseItem @relation(fields: [expenseItemId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settlement {
  id        String   @id @default(cuid())
  groupId   String
  fromUser  String
  toUser    String
  amount    Float
  status    String   @default("completed") // pending, completed
  method    String?  // UPI, PayPal, Venmo, Cash
  settledAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User     @relation("SettlementFrom", fields: [fromUser], references: [id])
  receiver  User     @relation("SettlementTo", fields: [toUser], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  expenseId String
  userId    String
  text      String
  createdAt DateTime @default(now())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // expense_added, payment_received, reminder
  payload   String   // JSON formatted metadata
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
