DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
# Required: protects recurring expense cron job (/api/cron/recurring) against public spam/unauthorized execution
CRON_SECRET="your-secure-random-cron-secret-token"

# Optional for local dev (falls back to in-memory), required in multi-instance/serverless production for durable rate limiting:
UPSTASH_REDIS_REST_URL="https://your-upstash-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

GEMINI_API_KEY="your-gemini-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
